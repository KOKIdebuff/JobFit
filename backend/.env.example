JOBFIT_ENVIRONMENT=development
JOBFIT_LOG_LEVEL=INFO
JOBFIT_DATABASE_URL=sqlite:///./data/jobfit.db
JOBFIT_SQLITE_BUSY_TIMEOUT_MS=5000
JOBFIT_JWT_SECRET=replace-with-a-long-random-secret-before-production
JOBFIT_AUTH_COOKIE_NAME=jobfit_session
JOBFIT_LLM_PROVIDER=deterministic
JOBFIT_LLM_BASE_URL=
JOBFIT_LLM_API_KEY=
JOBFIT_LLM_MODEL=
JOBFIT_LLM_TIMEOUT_SECONDS=30
JOBFIT_ALLOW_DEMO_PROVIDER=true
VITE_JOBFIT_API_BASE_URL=http://127.0.0.1:8000
VITE_JOBFIT_ENABLE_SPEECH_INPUT=true
